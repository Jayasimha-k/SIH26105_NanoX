# CyberOpt-RQ Backend Environment — SIH 2026
# ============================================================
# Copy this file to .env and fill in any needed values.
# For Offline SIH Demo Mode: no Supabase values needed.
# ============================================================

# ── Database ────────────────────────────────────────────────
# sqlite = offline SIH demo (no cloud needed)
# postgresql = production cloud mode
DATABASE_MODE=sqlite
DATABASE_URL=sqlite:///./cyberopt_rq.db

# ── Demo Mode ───────────────────────────────────────────────
SIH_DEMO_MODE=true
OFFLINE_MODE=true

# ── Security ────────────────────────────────────────────────
# Generate a strong random key for production. This is only
# for the local SIH demo; change before any real deployment.
SECRET_KEY=sih2026-demo-secret-key-local-only

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Supabase (Cloud Mode Only — NOT required for SIH demo) ──
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (Cloud Mode Only — NOT required for SIH demo) ──
CLERK_SECRET_KEY=

# ── Optional: LLM for Strix agent ───────────────────────────
# Leave empty for SIH demo (Strix falls back gracefully)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
