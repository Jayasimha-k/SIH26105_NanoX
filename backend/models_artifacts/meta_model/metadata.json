{
  "model_name": "Meta Model - Ensemble Stacking Classifier",
  "model_type": "Logistic Regression Stacker / Soft Voting",
  "version": "2.1.0",
  "author": "AI Cyber Risk Core Team",
  "description": "Synthesizes outputs from Base Models 1, 2, 3, and 4 into a single calibrated exploitation probability.",
  "input_features": ["model_1", "model_2", "model_3", "model_4"],
  "feature_weights": {
    "model_1": 0.35,
    "model_2": 0.25,
    "model_3": 0.20,
    "model_4": 0.20
  },
  "output_type": "probability",
  "output_range": [0.0, 1.0],
  "performance_metrics": {
    "accuracy": 0.948,
    "precision": 0.936,
    "recall": 0.928,
    "f1_score": 0.932,
    "roc_auc": 0.976,
    "pr_auc": 0.959,
    "brier_score": 0.038
  }
}
