{
  "model_name": "Model 1 - Exploitability Predictor",
  "model_type": "XGBoost Classifier",
  "version": "1.2.0",
  "author": "ML Security Research Team",
  "description": "Predicts likelihood of active threat exploitation using EPSS scores and attack vector characteristics.",
  "input_features": ["epss_score", "cisa_kev", "cvss_score"],
  "feature_weights": {
    "epss_score": 0.50,
    "cisa_kev": 0.35,
    "cvss_score": 0.15
  },
  "output_type": "probability",
  "output_range": [0.0, 1.0],
  "performance_metrics": {
    "accuracy": 0.912,
    "precision": 0.895,
    "recall": 0.884,
    "f1_score": 0.889,
    "roc_auc": 0.943,
    "pr_auc": 0.921,
    "brier_score": 0.062
  }
}
