  "output_type": "probability",
  "output_range": [0.0, 1.0],
  "performance_metrics": {
    "accuracy": 0.931,
    "precision": 0.910,
    "recall": 0.902,
    "f1_score": 0.906,
    "roc_auc": 0.958,
    "pr_auc": 0.937,
    "brier_score": 0.049
  }
}
