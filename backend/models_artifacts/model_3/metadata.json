{
  "model_name": "Model 3 - Asset Exposure & Reachability Model",
  "model_type": "Random Forest Regressor",
  "version": "2.0.1",
  "author": "Infrastructure Security Team",
  "description": "Quantifies asset network exposure, internet reachability, and attack surface posture.",
  "input_features": ["criticality_score", "exposure_level", "cvss_score"],
