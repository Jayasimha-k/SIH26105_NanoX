# CyberOpt-RQ Frontend Environment — SIH 2026
# ============================================================
# Copy this file to .env and fill in any needed values.
# For Offline SIH Demo Mode: defaults below work as-is.
# ============================================================

# ── Backend API ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ── Demo Mode ───────────────────────────────────────────────
VITE_SIH_DEMO_MODE=true
VITE_OFFLINE_MODE=true

# ── Clerk (Cloud Mode Only — NOT required for SIH demo) ──
# Leave empty to use local demo bypass auth (click "Enter Demo" on login screen)
VITE_CLERK_PUBLISHABLE_KEY=

# ── Supabase (Cloud Mode Only — NOT required for SIH demo) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
