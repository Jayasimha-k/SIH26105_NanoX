# ==========================================
# CyberOpt-RQ Git Ignore Rules (SIH 2026)
# ==========================================

# --- Python & Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# --- Python Virtual Environments ---
venv/
.venv/
.venv*/
env/
ENV/
env.bak/
venv.bak/
.venv_org_risk/

# --- Archives & Large Raw Zips & Datasets ---
*.zip
*.tar.gz
CyberOptRQ_Production_Models-20260916T120030Z-1-001/
data/cic_ids2017/
data/unsw_nb15/

# --- Hyperledger Fabric Private Crypto Material ---
fabric/crypto-config/
crypto-config/

# --- Node.js & Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Databases & Local Storage ---
*.db
*.sqlite
*.sqlite3
cyberopt_rq.db
backend/cyberopt_rq.db
models/organization-specific-risk/versions/*.joblib
!models/organization-specific-risk/versions/.gitkeep

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.local

# --- Logs & Cache ---
*.log
logs/
*.tmp
*.temp

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
